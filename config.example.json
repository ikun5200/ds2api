{
  "_comment": "DS2API 配置文件示例 - 复制为 config.json 使用",
  "_doc": "详细文档: https://github.com/ikun5200/ds2api",
  "keys": [
    "your-api-key-1",
    "your-api-key-2"
  ],
  "api_keys": [
    {
      "key": "your-api-key-1",
      "name": "主 API Key",
      "remark": "给 OpenAI 客户端使用"
    },
    {
      "key": "your-api-key-2",
      "name": "备用 API Key",
      "remark": "压测或临时调试"
    }
  ],
  "accounts": [
    {
      "_comment": "邮箱登录方式；密码登录前配置官网签发 device_id 或 DS2API_DEEPSEEK_DEVICE_ID",
      "name": "主账号",
      "remark": "优先用于生产流量",
      "email": "example1@example.com",
      "password": "your-password-1",
      "device_id": ""
    },
    {
      "_comment": "邮箱登录方式 - 账号2；密码登录前配置官网签发 device_id 或 DS2API_DEEPSEEK_DEVICE_ID",
      "name": "备用账号",
      "email": "example2@example.com",
      "password": "your-password-2",
      "disabled": true,
      "device_id": ""
    },
    {
      "_comment": "手机号登录方式（中国大陆）；密码登录前配置官网签发 device_id 或 DS2API_DEEPSEEK_DEVICE_ID",
      "mobile": "12345678901",
      "password": "your-password-3",
      "device_id": ""
    }
  ],
  "model_aliases": {
    "gpt-4o": "deepseek-flash",
    "gpt-5.5": "deepseek-flash",
    "gpt-5.3-codex": "deepseek-flash",
    "o3": "deepseek-flash"
  },
  "responses": {
    "store_ttl_seconds": 900
  },
  "current_input_file": {
    "enabled": true,
    "min_chars": 0
  },
  "thinking_injection": {
    "enabled": true,
    "prompt": ""
  },
  "output_integrity_guard": {
    "enabled": true,
    "prompt": ""
  },
  "embeddings": {
    "provider": "deterministic"
  },
  "admin": {
    "jwt_expire_hours": 24
  },
  "runtime": {
    "account_max_inflight": 2,
    "account_max_queue": 0,
    "global_max_inflight": 0,
    "token_refresh_interval_hours": 6
  },
  "auto_delete": {
    "mode": "none"
  }
}
