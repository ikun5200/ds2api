# DS2API runtime
# Runtime listen port inside the app/container
PORT=5001
# Docker Compose host port (compose only; container still listens on PORT)
DS2API_HOST_PORT=6011
LOG_LEVEL=INFO

# Admin authentication
DS2API_ADMIN_KEY=change-me

# Config loading (choose one)
# 1) file-based config
DS2API_CONFIG_PATH=/app/config.json
# 2) inline JSON or Base64 JSON
# DS2API_CONFIG_JSON=
# 3) legacy compatibility alias
# CONFIG_JSON=

# Optional: static admin assets path
# DS2API_STATIC_ADMIN_DIR=/app/static/admin

# Chat history storage
# builtin keeps the existing JSON file storage; external uses SQL.
# DS2API_DATABASE_MODE=builtin
# DS2API_DATABASE_MODE=external
# DS2API_DATABASE_TYPE=postgres
# DS2API_DATABASE_DSN=postgres://user:pass@postgres:5432/ds2api?sslmode=disable
# DS2API_DATABASE_TYPE=mysql
# DS2API_DATABASE_DSN=user:pass@tcp(mysql:3306)/ds2api?parseTime=true
# DS2API_DATABASE_TABLE_PREFIX=ds2api_
