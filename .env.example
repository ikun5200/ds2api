# DS2API 运行时
# 程序/容器内部监听端口
PORT=5001
# Docker Compose 宿主机端口（仅 compose 使用，容器内部仍监听 PORT）
DS2API_HOST_PORT=6011
LOG_LEVEL=INFO

# 管理台认证
DS2API_ADMIN_KEY=change-me

# 配置加载方式（三选一即可）
# 1) 配置文件
DS2API_CONFIG_PATH=/app/config.json
# 2) 原始 JSON 或 Base64 JSON
# DS2API_CONFIG_JSON=
# 3) 旧版本兼容别名
# CONFIG_JSON=

# 可选：管理台静态资源目录
# DS2API_STATIC_ADMIN_DIR=/app/static/admin

# Chat history / 响应记录存储
# 默认 builtin：使用本地 JSON 文件，适合本地或 Docker 单实例。
# external：使用外部 SQL 数据库，适合 Vercel、跨容器、多实例和长期保留响应记录。
# 外部存储只保存 Chat history，不保存账号、API Key、代理、Admin 密码或运行时设置。
# DS2API_DATABASE_MODE=builtin
# DS2API_DATABASE_MODE=external
# PostgreSQL 示例
# DS2API_DATABASE_TYPE=postgres
# DS2API_DATABASE_DSN=postgres://user:pass@postgres:5432/ds2api?sslmode=disable
# MySQL / MariaDB 示例
# DS2API_DATABASE_TYPE=mysql
# DS2API_DATABASE_DSN=user:pass@tcp(mysql:3306)/ds2api?parseTime=true
# 多套 DS2API 共用同一数据库时可修改表名前缀
# DS2API_DATABASE_TABLE_PREFIX=ds2api_
# 高并发或数据库连接数受限时再调整连接池
# DS2API_DATABASE_MAX_OPEN_CONNS=10
# DS2API_DATABASE_MAX_IDLE_CONNS=5
# DS2API_DATABASE_CONN_MAX_LIFETIME_SECONDS=300
